generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              String    @id @default(cuid())
  title           String
  description     String?
  category        String    // Marriage, Engagement, Couple Entry, Carnival, Pre-Wedding, Corporate, Birthday, Other
  imageUrl        String
  storagePublicId String?
  altText         String?
  date            String?
  venue           String?
  featured        Boolean   @default(false)
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category, active])
  @@index([featured, active])
  @@index([isDeleted])
}

model Service {
  id               String    @id @default(cuid())
  title            String
  description      String
  shortDescription String?
  fullDescription  String?
  imageUrl         String
  icon             String?
  featured         Boolean   @default(false)
  active           Boolean   @default(true)
  sortOrder        Int       @default(0)
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([isDeleted])
}

model TeamMember {
  id          String    @id @default(cuid())
  name        String
  role        String
  imageUrl    String
  bio         String?
  phone       String?
  socialLinks String?
  visible     Boolean   @default(true)
  sortOrder   Int       @default(0)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([visible, sortOrder])
  @@index([isDeleted])
}

model Lead {
  id           String    @id @default(cuid())
  name         String
  phone        String
  email        String?
  date         String    // Event date
  service      String
  budget       String?
  venue        String?
  message      String?
  status       String    @default("New") // New, Contacted, Follow-up, Meeting Scheduled, Quoted, Confirmed, Completed, Cancelled, Lost
  notes        String?
  assignedTo   String?
  followUpDate DateTime?
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([followUpDate])
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  photoUrl     String?
  review       String
  rating       Int      @default(5)
  eventType    String?
  date         String?
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, featured])
  @@index([isDeleted])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([isDeleted])
}

model BusinessSettings {
  id               String   @id @default("apex_settings")
  businessName     String   @default("APEX EVENT")
  tagline          String   @default("Crafting Unforgettable Moments & Grand Celebrations")
  logoUrl          String?
  faviconUrl       String?
  phone            String   @default("+91 9023815963")
  whatsapp         String   @default("+91 9023815963")
  email            String   @default("contact@apexevent.in")
  address          String   @default("Gokulwadi Farm Campus, Opp. Vraj Antonia, Near Sardar Chowk Ringroad, Sarthana Jakatnaka, Surat - 395006")
  googleMapsUrl    String   @default("https://maps.google.com/?q=Gokulwadi+Farm+Campus+Surat")
  instagramUrl     String   @default("https://www.instagram.com/apex__event?igsi=MTYzZGx2aDNibDF4ZQ==")
  facebookUrl      String?
  youtubeUrl       String?
  heroTitle        String   @default("Crafting Unforgettable Moments & Grand Celebrations")
  heroSubtitle     String   @default("Surat's Premier Event Stylists — Specializing in Weddings, Engagements, Grand Couple Entries, and Signature Carnivals.")
  heroImageUrl     String?
  primaryCtaText   String   @default("Book Consultation")
  primaryCtaLink   String   @default("#contact")
  secondaryCtaText String   @default("Chat on WhatsApp")
  secondaryCtaLink String   @default("https://wa.me/919023815963")
  aboutTitle       String   @default("About APEX EVENT")
  aboutText        String?
  aboutImageUrl    String?
  metaTitle        String   @default("APEX EVENT - Premier Event Planners & Decorators in Surat")
  metaDescription  String   @default("Surat's premier event management & decor company. Specializing in luxury wedding mandaps, engagement stages, couple entries, and carnivals in Surat, Gujarat.")
  keywords         String?
  updatedAt        DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  salt         String
  role         String    @default("ADMIN") // SUPER_ADMIN, ADMIN, EDITOR
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminUser String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

model VisitorLog {
  id         String   @id @default(cuid())
  ip         String?
  userAgent  String?
  referrer   String?
  path       String
  deviceType String?
  visitedAt  DateTime @default(now())

  @@index([visitedAt])
}

